generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  username     String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  /// Relações onde este usuário é o ALUNO (quem recebe a mentoria)
  mentorshipsAsStudent StudentTeacher[]    @relation("StudentRelation")
  /// Relações onde este usuário é o PROFESSOR (quem dá a mentoria)
  mentorshipsAsTeacher StudentTeacher[]    @relation("TeacherRelation")
  essays               Essay[]
  mockExams            MockExam[]
  userTopicProgresses  UserTopicProgress[]
  questionSessions     QuestionSession[]

  @@index([username])
  @@map("users") //(plural and snake_case)
}

model StudentTeacher {
  id         String   @id @default(uuid())
  studentId  String
  teacherId  String
  assignedAt DateTime @default(now()) @db.Timestamptz(3)

  student User @relation("StudentRelation", fields: [studentId], references: [id], onDelete: Cascade)
  teacher User @relation("TeacherRelation", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studentId, teacherId])
  @@map("student_teachers")
}

model Subject {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  category  String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  topics Topic[]

  @@index([slug])
  @@map("subjects")
}

model Topic {
  id        String   @id @default(uuid())
  subjectId String
  title     String
  position  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  subject             Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userTopicProgresses UserTopicProgress[]
  questionSessions    QuestionSession[]

  @@index([subjectId, position])
  @@map("topics")
}

model Essay {
  id          String   @id @default(uuid())
  authorId    String
  theme       String
  competency1 Int
  competency2 Int
  competency3 Int
  competency4 Int
  competency5 Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("essays")
}

model MockExam {
  id        String   @id @default(uuid())
  authorId  String
  title     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  author       User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  performances AreaPerformance[]

  @@map("mock_exams")
}

model AreaPerformance {
  id                   String        @id @default(uuid())
  mockExamId           String
  area                 KnowledgeArea
  correctCount         Int // Acertos
  certaintyCount       Int // Certeza
  doubtErrors          Int // Dúvida - Erro
  distractionErrors    Int // Erro por Distração
  interpretationErrors Int // Erro por Interpretação

  mockExam MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)

  @@unique([mockExamId, area])
  @@map("area_performances")
}

model UserTopicProgress {
  id        String      @id @default(uuid())
  authorId  String
  topicId   String
  status    TopicStatus
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)

  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  topic  Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([authorId, topicId])
  @@map("user_topic_progress")
}

model QuestionSession {
  id         String   @id @default(uuid())
  authorId   String
  topicId    String
  date       DateTime @default(dbgenerated("(now() AT TIME ZONE 'America/Sao_Paulo')::date")) @db.Date
  total      Int
  correct    Int
  isReviewed Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  topic  Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("question_sessions")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  SUPER_ADMIN
}

enum KnowledgeArea {
  LANGUAGES // Linguagens
  HUMANITIES // Ciências Humanas
  NATURAL_SCIENCES // Ciências da Natureza
  MATHEMATICS // Matemática
}

enum TopicStatus {
  COMPREHENDED // Compreendido
  PRACTICE // Praticar
  REVIEW // Revisar
}
